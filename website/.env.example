# Copy to .env.local and fill in. Never commit real secrets.

# Public base URL of the site (used for canonical URLs, sitemap, robots, JSON-LD, OG).
# Falls back to https://hashmarklabs.com when unset.
NEXT_PUBLIC_SITE_URL=https://hashmarklabs.com

# Resend API key (https://resend.com). When unset, POST /api/contact returns
# 503 {"error":"not_configured"} and the form shows direct email/WhatsApp fallbacks.
RESEND_API_KEY=

# Sender address on a domain verified in Resend, e.g. "Hashmark Labs <website@yourdomain.com>".
# Required together with RESEND_API_KEY.
CONTACT_FROM_EMAIL=

# Where enquiries are delivered. Defaults to hashmarklabs@gmail.com.
CONTACT_TO_EMAIL=hashmarklabs@gmail.com
